repository-code: "https://github.com/frandevaux/nasa-space-app-modis"
url: "https://github.com/frandevaux/nasa-space-app-modis"
license: MIT
keywords:
  - wildfire
  - hotspots
  - NASA FIRMS
  - remote sensing
  - deep learning
  - Córdoba
  - Argentina
