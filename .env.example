# Copiá este archivo a .env y completá los valores.
# .env no se versiona (está en .gitignore).

# FIRMS Area API key — obligatoria para pipeline/download_api.py.
# Se obtiene en https://firms.modaps.eosdis.nasa.gov/api/area/
MAP_KEY=

# Copernicus CDS: no usa .env. Configurá ~/.cdsapirc con tu token
